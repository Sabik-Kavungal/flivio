# ==============================================================================
# FLIVIO.STORE — ENVIRONMENT VARIABLES EXAMPLE
# Copy to .env for local development. Never commit .env files with real secrets.
# ==============================================================================

# --- Public Frontend Variables (Exposed to browser at Vite build time) ---
# Canonical production domain URL
VITE_SITE_URL="https://flivio.store"

# Optional: Cloudflare Web Analytics Beacon Token (Cloudflare Dashboard -> Web Analytics)
VITE_CF_WEB_ANALYTICS_TOKEN=""

# --- Server / Runtime Only (Never prefix private keys with VITE_) ---
# GEMINI_API_KEY: Reserved for server-side/AI Studio runtime only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in AI Studio runtime.
APP_URL="MY_APP_URL"
